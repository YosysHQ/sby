[tasks]
# don't run solver with no properties, don't return an empty PASS state
empty_err smtbmc bmc error

# don't run any solver with no properties, return PASS instead
empty_pass bmc3 sim3 smtbmc bmc pass

# works across mode/status
abc prove pass
btor cover fail

[options]
prove: mode prove
bmc: mode bmc
cover: mode cover
error:
# empty ERROR
expect ERROR
pass:
empty PASS
# expect PASS
fail:
empty FAIL
expect FAIL
--

[engines]
abc: abc pdr
btor: btor btormc
bmc3: abc bmc3
sim3: abc sim3
smtbmc: smtbmc yices

[script]
read -sv test.sv
prep -top top

[file test.sv]
module top(input i, output o);

assign o = ~i;

endmodule
